# Application Settings
PROJECT_NAME="TripDirect Backend"
API_V1_STR="/api/v1"

# Database Configuration
# For local SQLite development (default fallback): sqlite:///./tripdirect.db
# For PostgreSQL: postgresql://username:password@localhost:5432/tripdirect_db
DATABASE_URL=sqlite:///./tripdirect.db

# JWT Security Settings
JWT_SECRET_KEY=change_this_to_a_super_secret_key_in_production_123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
